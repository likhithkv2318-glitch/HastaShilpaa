<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Header banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_secondary"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Price Suggester"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your local costs to get a fair price"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Input Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊 Your Local Costs"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="@font/poppins_bold" android:layout_marginBottom="14dp" />

                    <!-- Row: Bamboo + Cane prices -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Bamboo ₹/pole" android:layout_marginEnd="6dp"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBambooCostPerPole"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Cane ₹/meter" android:layout_marginStart="6dp"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCaneCostPerMeter"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Row: Poles used + Cane used -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Poles used" android:layout_marginEnd="6dp"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBambooPoles"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Cane meters" android:layout_marginStart="6dp"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCaneMeters"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- OR direct material cost -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/InputLayout" android:hint="OR Direct Material Cost (₹)"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMaterialCost"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Finishing cost -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/InputLayout" android:hint="Finishing &amp; Polish Cost (₹)"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFinishingCost"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Row: Hourly rate + Hours -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Your Labour ₹/hr" android:layout_marginEnd="6dp"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHourlyRate"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" style="@style/InputLayout"
                            android:hint="Hours Worked" android:layout_marginStart="6dp"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHoursWorked"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:fontFamily="@font/poppins_regular" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Overhead SeekBar -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Overhead %"
                            android:textColor="@color/text_secondary" android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium" />
                        <TextView android:id="@+id/tvOverheadValue" android:layout_width="48dp"
                            android:layout_height="wrap_content" android:gravity="end"
                            android:textColor="@color/primary" android:textSize="14sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekOverhead" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:max="50" android:progress="15"
                        android:progressTint="@color/primary" android:thumbTint="@color/primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Profit SeekBar -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Profit Margin %"
                            android:textColor="@color/text_secondary" android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium" />
                        <TextView android:id="@+id/tvProfitValue" android:layout_width="48dp"
                            android:layout_height="wrap_content" android:gravity="end"
                            android:textColor="@color/secondary" android:textSize="14sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekProfit" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:max="80" android:progress="30"
                        android:progressTint="@color/secondary" android:thumbTint="@color/secondary"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnCalculate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Calculate Suggested Price"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/primary"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Result Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:alpha="0"
                android:visibility="invisible"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_price_result"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Suggested Selling Price"
                        android:textColor="#A5D6A7"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/tvSuggestedPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ —"
                        android:textColor="#E8C547"
                        android:textSize="42sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/tvPriceAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginBottom="16dp" />

                    <!-- Cost Breakdown -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#40FFFFFF" android:layout_marginBottom="12dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cost Breakdown" android:textColor="#B2DFDB"
                        android:textSize="12sp" android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Breakdown rows -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Raw Material"
                            android:textColor="#B0FFFFFF" android:textSize="12sp" android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/tvBreakMaterial" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#FFFFFF"
                            android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Labour Cost"
                            android:textColor="#B0FFFFFF" android:textSize="12sp" android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/tvBreakLabour" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#FFFFFF"
                            android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Finishing"
                            android:textColor="#B0FFFFFF" android:textSize="12sp" android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/tvBreakFinishing" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#FFFFFF"
                            android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Overhead"
                            android:textColor="#B0FFFFFF" android:textSize="12sp" android:fontFamily="@font/poppins_regular" />
                        <TextView android:id="@+id/tvBreakOverhead" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#FFFFFF"
                            android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#40FFFFFF" android:layout_marginVertical="8dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Total Cost"
                            android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/poppins_bold" />
                        <TextView android:id="@+id/tvTotalCost" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Profit"
                            android:textColor="#E8C547" android:textSize="13sp" android:fontFamily="@font/poppins_bold" />
                        <TextView android:id="@+id/tvBreakProfit" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#E8C547"
                            android:textSize="13sp" android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
