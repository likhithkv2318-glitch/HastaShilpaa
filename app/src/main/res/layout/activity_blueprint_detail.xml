<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Design Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDesignTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/text_primary" />
                            <TextView
                                android:id="@+id/tvDesignCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Stats row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:background="@color/surface_variant"
                        android:padding="12dp"
                        android:gravity="center">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvDifficulty" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:fontFamily="@font/poppins_bold"
                                android:textSize="14sp" android:textColor="@color/secondary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Difficulty" android:fontFamily="@font/poppins_regular"
                                android:textSize="11sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/divider" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvEstimatedTime" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:fontFamily="@font/poppins_bold"
                                android:textSize="14sp" android:textColor="@color/primary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Est. Time" android:fontFamily="@font/poppins_regular"
                                android:textSize="11sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/divider" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMarketValue" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:fontFamily="@font/poppins_bold"
                                android:textSize="14sp" android:textColor="@color/secondary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Market Value" android:fontFamily="@font/poppins_regular"
                                android:textSize="11sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Blueprint Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📐 Blueprint (Pinch to Zoom)"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_blueprint_canvas">

                    <ImageView
                        android:id="@+id/ivBlueprint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="#60000000"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Pinch to zoom · Double-tap resets"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetZoom"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:text="Reset"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="12sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Materials -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪵 Materials Needed"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/materialsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp" />

            <!-- Quick stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/chip_bg"
                    android:padding="12dp" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎋 Bamboo" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
                    <TextView android:id="@+id/tvBambooPoles" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/primary"
                        android:textSize="16sp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="0dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/chip_bg"
                    android:padding="12dp" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪢 Cane" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
                    <TextView android:id="@+id/tvCaneMeters" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/secondary"
                        android:textSize="16sp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dimensions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Dimensions"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:id="@+id/dimensionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />

            </androidx.cardview.widget.CardView>

            <!-- Assembly Steps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔧 Assembly Steps"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadBlueprint"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="⬇ Download"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_semibold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp" />

                <View android:layout_width="8dp" android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareBlueprint"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="↗ Share"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp"
                    app:backgroundTint="@android:color/transparent"
                    android:fontFamily="@font/poppins_semibold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPriceSuggester"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="💰 Calculate Price for This Design"
                android:textColor="@color/primary_dark"
                android:fontFamily="@font/poppins_semibold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
